generator client {
  provider = "prisma-client-js"
  jsTarget = "ES2022"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
  owner
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")  
  firstName    String?  @map("first_name")     
  lastName     String?  @map("last_name")      
  avatar       String?  
  phoneNumber  String?  @map("phone_number")                        
  
  provider     String?   
  providerId   String?   @map("provider_id")   
  emailVerified Boolean  @default(false) @map("email_verified")
  
  resetToken   String?   @map("reset_token")
  resetExpires DateTime? @map("reset_expires")
  
  verificationToken   String?   @unique @map("verification_token")
  verificationExpires DateTime? @map("verification_expires")
  
  role        UserRole   @default(user)
  isActive    Boolean    @default(true) @map("is_active")
  
  lastLogin   DateTime? @map("last_login")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  companyMembers CompanyMember[]
  customers      Customer[]

  @@unique([provider, providerId])  
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String   @default("")
  tags        String[] 
  timezone    String   @default("UTC+3")
  city        String
  currency    String   @default("RUB")
  address     String?
  logo        String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true) @map("is_active")

  bookingLeadDays      Int                @default(30)
  workScheduleType     WorkScheduleType   @default(EVERY_DAY)
  slotInterval         Int                @default(30)
  defaultStartTime     String             @default("09:00")
  defaultEndTime       String             @default("18:00")   
  customWorkDays       Json?              // Массив объектов: [{ dayOfWeek: 1, slotInterval: 30, startTime: "09:00", endTime: "18:00" }, ...]
                                          // dayOfWeek: 1=пн, 2=вт, ..., 7=вс
  holidays             DateTime[]         @default([])
  autoConfirmBooking   Boolean            @default(false) 
  paymentMethods       PaymentMethod      @default(BOTH)         

  members     CompanyMember[]
  customers   Customer[]
  services    Service[]
  bookings    Booking[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model CompanyMember {
  id                  String                      @id @default(uuid())
  userId              String                      @map("user_id")
  companyId           String                      @map("company_id")
  role                MemberRole                  @default(member)
  permissions         String[]                    

  scheduleType        CompanyMemberScheduleType?  @map("schedule_type")
  startWorkTime       String                      @map("start_work_time")
  endWorkTime         String                      @map("end_work_time")
  startWorkDay        DateTime?                   @map("start_work_day") 
  customWorkSchedule  Json?                       @map("custom_work_schedule") 
                                                  // Массив объектов: [{ dayOfWeek: 1, startWorkTime: "09:00", endWorkTime: "18:00" }, ...]
                                                  // dayOfWeek: 1=пн, 2=вт, ..., 7=вс
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, companyId])
  @@map("company_members")
}

model Customer {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")  
  companyId   String   @map("company_id")
  email       String
  
  totalBookings Int     @default(0) @map("total_bookings")
  
  user        User?    @relation(fields: [userId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, companyId])
  @@map("customers")
}

model Service {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String
  description String?
  duration    Int     
  price       Decimal
  currency    String   @default("RUB")
  isActive    Boolean  @default(true) @map("is_active")
  
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model Booking {
  id          String        @id @default(uuid())
  companyId   String        @map("company_id")
  customerId  String        @map("customer_id")
  serviceId   String        @map("service_id")
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  status      BookingStatus @default(pending)
  totalPrice  Decimal       @map("total_price")
  
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bookings")
}

enum MemberRole {
  owner
  admin
  manager
  receptionist
  member
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum WorkScheduleType {
  FIVE_TWO     
  EVERY_DAY    
  CUSTOM       
}

enum PaymentMethod {
  CASH
  PREPAYMENT
  BOTH
}

enum CompanyMemberScheduleType {
  FIVE_TWO     
  TWO_TWO    
  CUSTOM       
}